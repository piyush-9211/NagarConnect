generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  passwordHash  String
  phone         String?
  role          UserRole       @default(CITIZEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  reports       Report[]
}

model Report {
  id                  String          @id @default(uuid())
  title               String
  description         String
  issueType           String
  status              ReportStatus    @default(PENDING)
  latitude            Float
  longitude           Float
  address             String?
  citizenId           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  aiClass             String?
  aiConfidence        Float?
  aiDepartment        String?
  aiSeverity          String?
  estimatedRepairCost Float?
  assignment          Assignment?
  images              Image[]
  citizen             User            @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  statusHistory       StatusHistory[]
}

model Image {
  id         String  @id @default(uuid())
  imageUrl   String
  aiClass    String?
  confidence Float?
  reportId   String
  report     Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model StatusHistory {
  id        String       @id @default(uuid())
  oldStatus ReportStatus
  newStatus ReportStatus
  remarks   String?
  reportId  String
  changedAt DateTime     @default(now())
  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String   @id @default(uuid())
  department  String
  officerName String?
  reportId    String   @unique
  assignedAt  DateTime @default(now())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  CITIZEN
  ADMIN
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}
